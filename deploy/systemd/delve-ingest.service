[Unit]
Description=Delve Atlas: Jetstream ingest (replay, then live tail)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/delve-atlas/env
ExecStart=@REPO@/bin/ingest -days 7
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
