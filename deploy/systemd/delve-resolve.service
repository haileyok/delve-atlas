[Unit]
Description=Delve Atlas: resolve handles for new accounts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/delve-atlas/env
ExecStart=@REPO@/bin/resolve -watch
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
